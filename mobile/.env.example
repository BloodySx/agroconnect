# Exemplo de configuração para desenvolvimento
# Copie este arquivo para .env e preencha com a URL real da API
# Em desenvolvimento, use http://10.0.2.2:3333 (Android) ou http://localhost:3333 (iOS)
# Ou execute "npx expo start --lan" para detectar o IP automaticamente

# Exemplo de configuração para produção
# Copie este arquivo para .env e preencha com a URL real da API
# NÃO use endereços locais (localhost, 127.0.0.1, IPs de rede) em produção

EXPO_PUBLIC_API_URL=http://10.0.2.2:3333